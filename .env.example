# Application CLI Configuration
APP_CLI_NAME=gsync
APP_CLI_VERSION=dev
APP_CLI_LOG_LEVEL=error
APP_CLI_TIMEOUT=1m

# Database Configuration (PostgreSQL)
DB_PROTOCOL=postgresql
DB_ADDRESS=localhost:5432
DB_NAME=data_transaksi
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_OPTION=
DB_MAX_OPEN_CONNECTIONS=10
DB_MAX_IDLE_CONNECTIONS=2 # for gorm db
DB_MAX_CONNECTION_LIFETIME=60 # in seconds | for gorm db
DB_MAX_CONNECTION_IDLE_TIME=20 # in seconds

# Google Sheets Configuration
GSHEET_CREDENTIAL_PATH="/path/to/your/google-credentials.json"
GSHEET_DATA_TRANSAKSI_ID=your_sheet_id_here
GSHEET_DATA_TRANSAKSI_TRANSACTION_RANGE="Transaction!B5:H"
GSHEET_DATA_TRANSAKSI_TRANSFER_RANGE="Transfer!B5:G"
GSHEET_DATA_TRANSAKSI_CREDIT_RANGE="Liquid Assets!O5:R27" #invalid
GSHEET_DATA_TRANSAKSI_DEBT_RANGE="Liquid Assets!U5:X27" #invalid
GSHEET_DATA_TRANSAKSI_ACCOUNT_RANGE="Liquid Assets!B5:N28"
GSHEET_DATA_TRANSAKSI_CATEGORY_RANGE="Categories & Budget Mapping!B5:G98"
GSHEET_REKAP_KEUANGAN_ID=your_sheet_id_here
GSHEET_REKAP_KEUANGAN_RESUME_START_COL_RANGE=Resume!B3

# Apps Script Configuration
APPS_SCRIPT_URL=https://script.google.com/macros/s/your_script_id/exec

# BudgetMate API Configuration
BUDGETMATE_API_URL=https://your-budgetmate-instance.com
BUDGETMATE_API_EMAIL=your_email@example.com
BUDGETMATE_API_PASSWORD=your_password

# BudgetBakers Playwright/Browser Configuration
# Run browser headless (default: false)
BB_HEADLESS=false
# Slow motion delay (default: 100)
BB_SLOW_MO=100
# Delay between transactions (default: 2000)
BB_DELAY_BETWEEN=2000
# Delay after submit (default: 1500)
BB_DELAY_SUBMIT=1500
# Delay after field (default: 300)
BB_DELAY_FIELD=300

# BudgetBakers API Configuration
BUDGETBAKERS_API_TOKEN=your_budgetbakers_token_here
